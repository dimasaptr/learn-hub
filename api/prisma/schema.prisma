// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

/**
 * DATABASE CONFIGURATION
 */
datasource db {
  provider = "postgresql"
}

/**
 * =========================================
 * ENUMS
 * =========================================
 */

// Menentukan peran pengguna dalam sistem
enum Role {
  CUSTOMER
  ORGANIZER
}

// Menentukan status siklus hidup sebuah acara
enum EventStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  CANCELED
}

// Menentukan status perjalanan sebuah transaksi
enum TransactionStatus {
  WAITING_FOR_PAYMENT
  WAITING_FOR_ADMIN_CONFIRMATION
  DONE
  REJECTED
  EXPIRED
  CANCELED
}

/**
 * =========================================
 * MODELS (TABLES)
 * =========================================
 */

// TABEL: User
// Menyimpan data akun, profil, dan informasi referral
model User {
  id             Int      @id @default(autoincrement())
  name           String
  email          String   @unique
  password       String
  profilePicture String?
  role           Role     @default(CUSTOMER)
  referralCode   String   @unique
  referredById   Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relasi
  referredBy   User?         @relation("UserReferrals", fields: [referredById], references: [id])
  referrals    User[]        @relation("UserReferrals")
  points       Point[]
  coupons      Coupon[]
  events       Event[]
  transactions Transaction[]
  reviews      Review[]

  @@index([referralCode])
}

// TABEL: Point
// Menyimpan riwayat poin yang didapat dari referral (sistem FIFO)
model Point {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  amount    Int
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// TABEL: Coupon
// Menyimpan kupon diskon reward untuk pengguna baru
model Coupon {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  code      String   @unique
  amount    Int // Nominal atau persentase pemotongan
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

// TABEL: Event
// Menyimpan informasi lengkap mengenai acara/event
model Event {
  id          Int         @id @default(autoincrement())
  organizerId Int
  organizer   User        @relation(fields: [organizerId], references: [id])
  name        String
  price       Int         @default(0)
  description String      @db.Text
  location    String
  category    String
  seats       Int
  startDate   DateTime
  endDate     DateTime
  image       String?
  status      EventStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Relasi
  vouchers     Voucher[]
  transactions Transaction[]
  reviews      Review[]

  @@index([organizerId])
  @@index([category, location])
}

// TABEL: Voucher
// Menyimpan kode promosi khusus untuk event tertentu (dibuat oleh Organizer)
model Voucher {
  id             Int      @id @default(autoincrement())
  eventId        Int
  event          Event    @relation(fields: [eventId], references: [id])
  code           String   @unique
  discountAmount Int
  quota          Int
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([eventId])
}

// TABEL: Transaction
// Menyimpan riwayat pendaftaran/pembelian tiket event
model Transaction {
  id           Int               @id @default(autoincrement())
  customerId   Int
  customer     User              @relation(fields: [customerId], references: [id])
  eventId      Int
  event        Event             @relation(fields: [eventId], references: [id])
  status       TransactionStatus @default(WAITING_FOR_PAYMENT)
  totalPrice   Int
  paymentProof String?
  pointsUsed   Int               @default(0)
  voucherId    Int?
  couponId     Int?
  expiresAt    DateTime // Batas waktu untuk upload bukti bayar
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([customerId])
  @@index([eventId])
}

// TABEL: Review
// Menyimpan ulasan dan rating dari peserta setelah event selesai
model Review {
  id         Int      @id @default(autoincrement())
  customerId Int
  customer   User     @relation(fields: [customerId], references: [id])
  eventId    Int
  event      Event    @relation(fields: [eventId], references: [id])
  rating     Int
  comment    String?  @db.Text
  createdAt  DateTime @default(now())

  @@index([customerId, eventId])
}
